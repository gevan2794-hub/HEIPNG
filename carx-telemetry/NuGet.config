<?xml version="1.0" encoding="utf-8"?>
<!--
  Default sources: nuget.org only, so every project restores anywhere.

  BepInEx publishes to its own feed, not nuget.org, so a real (non-stub) mod build needs
  build/nuget.bepinex.config as well - build.ps1 passes it automatically. It is kept out
  of here because NuGet contacts every configured source on restore regardless of which
  packages a project actually wants, so listing it would break the tests and the SimHub
  plugin on any machine that cannot reach that host.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
