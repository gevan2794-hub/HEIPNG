<?xml version="1.0" encoding="utf-8"?>
<!--
  Sources for a real mod build, which needs BepInEx assemblies to compile against.
  Pass it to 'dotnet restore src/CarX.Telemetry.Mod' with the configfile switch.
  (An XML comment cannot contain a double hyphen, so the switch is named, not written.)
  build.ps1 does this for you.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
