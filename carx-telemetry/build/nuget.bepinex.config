<?xml version="1.0" encoding="utf-8"?>
<!--
  Sources for a real mod build, which needs BepInEx assemblies to compile against.
  Used via: dotnet restore src/CarX.Telemetry.Mod --configfile build/nuget.bepinex.config
  build.ps1 does this for you.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
