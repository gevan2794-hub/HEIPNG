<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SimHub plugins are .NET Framework 4.8 assemblies dropped next to SimHub.exe.
    SimHub does not publish its assemblies on NuGet, so this references them straight
    out of the install directory. Override the path if SimHub lives elsewhere:

      dotnet build -c Release -p:SimHubPath="D:\Games\SimHub"
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>CarX.Telemetry.SimHub</AssemblyName>
    <RootNamespace>CarX.Telemetry.Receiver</RootNamespace>
    <Version>0.1.0</Version>
    <SimHubPath Condition="'$(SimHubPath)' == ''">C:\Program Files (x86)\SimHub</SimHubPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarX.Telemetry.Shared\CarX.Telemetry.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseStubs)' != 'true'">
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubPath)\SimHub.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>$(SimHubPath)\GameReaderCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SimHub.Logging.Current lives in its own assembly, not SimHub.Plugins, and it
         hands back a log4net ILog - so both have to be referenced to call .Info/.Warn. -->
    <Reference Include="SimHub.Logging">
      <HintPath>$(SimHubPath)\SimHub.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(SimHubPath)\log4net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- '-p:UseStubs=true' type-checks this project without SimHub installed. The result
       cannot run; see build/stubs/README.md. -->
  <ItemGroup Condition="'$(UseStubs)' == 'true'">
    <ProjectReference Include="..\..\build\stubs\SimHub.Stubs\SimHub.Stubs.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets developers build straight into the SimHub folder for a quick edit/restart loop. -->
    <None Include="CarXTelemetry.config" Condition="Exists('CarXTelemetry.config')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
